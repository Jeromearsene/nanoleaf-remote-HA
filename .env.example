# Copy this file to `.env` and fill in your MQTT broker's details.
# `.env` is git-ignored — never commit your real credentials.
# All of these are optional; defaults match a local, unauthenticated
# broker (e.g. Home Assistant's Mosquitto add-on reached from the same
# machine).

# Hostname or IP address of your MQTT broker.
MQTT_HOST=localhost

# Port your broker listens on.
MQTT_PORT=1883

# Leave both empty/commented if your broker doesn't require authentication.
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Face numbering table given by `poetry run calibrate` (12 comma-separated
# numbers: the Nth value is the real face for the Nth detected position).
# Leave empty for the default 1,2,3,...,12.
# FACE_MAP=
